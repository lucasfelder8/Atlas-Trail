{
  "name": "mystery-destination",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:data": "node scripts/build-data.ts",
    "gen:puzzles": "node scripts/generate-puzzles.ts",
    "validate": "node scripts/validate-puzzles.ts",
    "test": "node --test tests/",
    "typecheck": "tsc --noEmit",
    "build": "npm run validate && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "d3-geo": "^3.1.2",
    "d3-selection": "^3.0.1",
    "d3-zoom": "^3.0.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^26.6.6",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-server": "^3.0.4",
    "@types/topojson-simplify": "^3.0.3",
    "@types/topojson-specification": "^1.0.5",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
